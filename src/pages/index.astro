---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Categorized buckets for clear navigation
const secretSantaPosts = allPosts.filter(p => 
  p.data.tags.includes('secret santa') || p.data.tags.includes('white elephant')
);

const stockingPosts = allPosts.filter(p => 
  p.data.tags.includes('stocking stuffers') || p.data.tags.includes('stocking fillers')
);

const printablePosts = allPosts.filter(p => 
  p.data.category === 'Printables' || p.data.isPrintable === true
);
---

<Layout
  title="Holiday Gift Hub | US & UK Curated Secret Santa & Stocking Fillers"
  description="Clear holiday gift guides for US and UK shoppers. Secret Santa picks under £15, White Elephant gifts under $20, teen stocking stuffers, and free party printables."
>
  <!-- Hero Section with Clear Value Proposition -->
  <section class="bg-gradient-to-b from-red-50/80 via-white to-slate-50 py-12 sm:py-16 border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
      <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider bg-red-100 text-red-800 px-3.5 py-1.5 rounded-full mb-4">
        <span>🎅</span>
        <span>Tested Gift Ideas for US & UK Holiday Shoppers</span>
      </span>

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-black text-slate-900 tracking-tight leading-tight mb-4">
        Stop Guessing. Find Gifts That <br class="hidden sm:inline" />
        <span class="text-red-700 underline decoration-red-300">Actually Get Laughs & Use</span>.
      </h1>

      <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto mb-8 leading-relaxed">
        Curated White Elephant swaps under $20, Secret Santa picks under £15, and instant printable party games with verified 2-day Prime delivery.
      </p>

      <!-- Fast Mission Bar (Where to Go for What) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto text-left">
        <!-- Mission 1: Secret Santa -->
        <a
          href="#secret-santa"
          class="bg-white p-5 rounded-2xl border-2 border-slate-200/90 hover:border-red-500 shadow-sm hover:shadow-md transition group flex flex-col justify-between"
        >
          <div>
            <div class="text-3xl mb-2 group-hover:scale-110 transition-transform">🎅</div>
            <h3 class="font-bold text-slate-900 text-base mb-1 group-hover:text-red-700 transition">
              Secret Santa & Office
            </h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">
              Gifts under $20 / £15 for coworkers and party swaps.
            </p>
          </div>
          <span class="text-xs font-bold text-red-700 flex items-center gap-1">
            Browse Guides <span>↓</span>
          </span>
        </a>

        <!-- Mission 2: Stocking Fillers -->
        <a
          href="#stocking-fillers"
          class="bg-white p-5 rounded-2xl border-2 border-slate-200/90 hover:border-amber-500 shadow-sm hover:shadow-md transition group flex flex-col justify-between"
        >
          <div>
            <div class="text-3xl mb-2 group-hover:scale-110 transition-transform">🧦</div>
            <h3 class="font-bold text-slate-900 text-base mb-1 group-hover:text-amber-700 transition">
              Stocking Fillers
            </h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">
              Compact tech & EDC gadgets under $15 / £12.
            </p>
          </div>
          <span class="text-xs font-bold text-amber-700 flex items-center gap-1">
            Browse Fillers <span>↓</span>
          </span>
        </a>

        <!-- Mission 3: Free Printables -->
        <a
          href="/printables"
          class="bg-emerald-50/80 p-5 rounded-2xl border-2 border-emerald-300 hover:border-emerald-500 shadow-sm hover:shadow-md transition group flex flex-col justify-between"
        >
          <div>
            <div class="text-3xl mb-2 group-hover:scale-110 transition-transform">🎲</div>
            <h3 class="font-bold text-emerald-950 text-base mb-1 group-hover:text-emerald-700 transition">
              Free Party Printables
            </h3>
            <p class="text-xs text-emerald-800 leading-relaxed mb-3">
              Questionnaire slips & trivia PDFs ready in 10 seconds.
            </p>
          </div>
          <span class="text-xs font-bold text-emerald-800 flex items-center gap-1">
            Download Kits <span>→</span>
          </span>
        </a>

        <!-- Mission 4: Dual Currency Assurance -->
        <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 flex flex-col justify-between">
          <div>
            <div class="text-3xl mb-2">⚖️</div>
            <h3 class="font-bold text-slate-900 text-base mb-1">
              US & UK Multi-Store
            </h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">
              Every guide features direct Amazon US & Amazon UK buttons with live price checking.
            </p>
          </div>
          <span class="text-[11px] font-semibold text-slate-400">Zero currency confusion</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1: Secret Santa & White Elephant Hub -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-14 border-b border-slate-200" id="secret-santa">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-red-700 bg-red-50 border border-red-200 px-3 py-1 rounded-full mb-2 inline-block">
          Office & Party Exchanges
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Secret Santa & White Elephant Guides
        </h2>
        <p class="text-sm text-slate-500 mt-1">Tested picks under $20 / £15 that get stolen in the exchange rounds.</p>
      </div>
      <span class="text-xs font-bold text-slate-400">{secretSantaPosts.length} Guides Available</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {secretSantaPosts.map((post) => (
        <a
          href={`/blog/${post.slug}`}
          class="group bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md hover:border-red-300 transition duration-200 flex flex-col"
        >
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-red-700 bg-red-50 px-2.5 py-0.5 rounded-full">
                {post.data.category}
              </span>
              <span class="text-xs text-slate-400 font-medium">Under $20 / £16</span>
            </div>
            <h3 class="text-xl font-bold text-slate-900 group-hover:text-red-700 transition mb-2 leading-snug">
              {post.data.title}
            </h3>
            <p class="text-sm text-slate-600 line-clamp-2 mb-4 flex-1">
              {post.data.description}
            </p>
            <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-red-700 group-hover:translate-x-1 transition">
              <span>See Top Rated Picks (US & UK)</span>
              <span>→</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Section 2: Stocking Fillers Hub -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-14 border-b border-slate-200" id="stocking-fillers">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-amber-800 bg-amber-50 border border-amber-200 px-3 py-1 rounded-full mb-2 inline-block">
          Budget Small Wins
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Stocking Stuffers & Pocket Gadgets
        </h2>
        <p class="text-sm text-slate-500 mt-1">Compact tech, EDC gear, and clever treats under $15 / £12.</p>
      </div>
      <span class="text-xs font-bold text-slate-400">{stockingPosts.length} Guide Available</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {stockingPosts.map((post) => (
        <a
          href={`/blog/${post.slug}`}
          class="group bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md hover:border-amber-300 transition duration-200 flex flex-col"
        >
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-amber-800 bg-amber-50 px-2.5 py-0.5 rounded-full">
                {post.data.category}
              </span>
              <span class="text-xs text-slate-400 font-medium">Under $15 / £12</span>
            </div>
            <h3 class="text-xl font-bold text-slate-900 group-hover:text-amber-700 transition mb-2 leading-snug">
              {post.data.title}
            </h3>
            <p class="text-sm text-slate-600 line-clamp-2 mb-4 flex-1">
              {post.data.description}
            </p>
            <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-amber-700 group-hover:translate-x-1 transition">
              <span>View Stocking Fillers</span>
              <span>→</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Section 3: Free Party Printables Callout -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-14" id="printables">
    <div class="bg-gradient-to-r from-emerald-800 to-teal-900 rounded-3xl p-8 sm:p-12 text-white shadow-lg flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="max-w-xl">
        <span class="inline-block bg-white/20 text-emerald-100 text-xs uppercase tracking-widest font-bold px-3 py-1 rounded-full mb-3">
          Instant Download • No Shipping Needed
        </span>
        <h2 class="text-2xl sm:text-4xl font-black mb-3 leading-tight">
          Running a Secret Santa or Holiday Party?
        </h2>
        <p class="text-emerald-100 text-sm sm:text-base leading-relaxed mb-6">
          Download our free printable questionnaires, wishlist cards, and icebreaker trivia sheets formatted for home printers.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/printables"
            class="bg-white text-emerald-900 hover:bg-emerald-50 font-bold text-sm px-6 py-3.5 rounded-xl shadow transition"
          >
            Browse All Free Printables →
          </a>
          <a
            href="/blog/free-secret-santa-questionnaire-printable"
            class="bg-emerald-700 hover:bg-emerald-600 text-white font-semibold text-sm px-5 py-3.5 rounded-xl border border-emerald-500 transition"
          >
            Secret Santa Questionnaire PDF
          </a>
        </div>
      </div>
      <div class="text-7xl sm:text-8xl shrink-0 drop-shadow-md">
        🎲
      </div>
    </div>
  </section>
</Layout>
