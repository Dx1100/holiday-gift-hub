---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Holiday Gift Hub | Top Secret Santa & Festive Gifts (US & UK 2026)"
  description="Curated holiday gift guides, Secret Santa picks under £15/$20, party games, and last-minute holiday shopping essentials for the US and UK."
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-red-50/70 to-slate-50 py-16 sm:py-24 border-b border-slate-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
      <span class="inline-block text-xs font-bold tracking-widest uppercase bg-red-100 text-red-800 px-4 py-1.5 rounded-full mb-4">
        🎄 Festive Season 2026 Ready
      </span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-slate-955 tracking-tight leading-tight mb-6">
        Curated Gift Guides That Actually <span class="text-red-700 underline decoration-red-300">Get Laughs & Smiles</span>.
      </h1>
      <p class="text-base sm:text-xl text-slate-600 max-w-2xl mx-auto mb-8">
        Tested Secret Santa ideas under £15, crowd-pleasing stocking fillers, and instant printable holiday games with 2-day Amazon Prime shipping.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-semibold text-slate-700">
        <span class="flex items-center gap-1.5 bg-white px-3.5 py-2 rounded-full border border-slate-200 shadow-sm">
          🇺🇸 Amazon US Verified
        </span>
        <span class="flex items-center gap-1.5 bg-white px-3.5 py-2 rounded-full border border-slate-200 shadow-sm">
          🇬🇧 Amazon UK Verified
        </span>
        <span class="flex items-center gap-1.5 bg-white px-3.5 py-2 rounded-full border border-slate-200 shadow-sm">
          ⚡ Fast Prime Shipping Picks
        </span>
      </div>
    </div>
  </section>

  <!-- Guides Grid -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16" id="guides">
    <div class="flex items-center justify-between mb-8 border-b border-slate-200 pb-4">
      <h2 class="text-2xl font-black text-slate-900 tracking-tight">Latest Holiday Guides</h2>
      <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">{posts.length} Curated Guides</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post) => (
        <a
          href={`/blog/${post.slug}`}
          class="group bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md hover:border-red-300 transition duration-200 flex flex-col"
        >
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold text-red-700 bg-red-50 border border-red-100 px-2.5 py-0.5 rounded-full">
                {post.data.category}
              </span>
              <span class="text-xs text-slate-400">Q4 2026</span>
            </div>
            <h3 class="text-xl font-bold text-slate-900 group-hover:text-red-700 transition mb-3 leading-snug">
              {post.data.title}
            </h3>
            <p class="text-sm text-slate-600 line-clamp-3 mb-6 flex-1">
              {post.data.description}
            </p>
            <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-red-700 group-hover:translate-x-1 transition">
              <span>Explore Top Picks</span>
              <span>→</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
