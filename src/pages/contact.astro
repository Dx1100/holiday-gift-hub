---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Editorial Team | Holiday Gift Hub"
  description="Get in touch with the Holiday Gift Hub editorial team for feedback, brand suggestions, or printable support."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-14">
    <span class="inline-block text-xs font-bold uppercase tracking-wider text-red-700 bg-red-50 border border-red-200 px-3 py-1 rounded-full mb-3">
      Get In Touch
    </span>
    <h1 class="text-3xl sm:text-4xl font-black text-slate-900 mb-4">Contact Our Editorial Team</h1>
    <p class="text-base text-slate-600 mb-8 leading-relaxed">
      Have a question about our gift guides, want to submit a product for review, or need assistance with our free printable holiday kits? Reach out below.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <h3 class="text-lg font-bold text-slate-900 mb-2 flex items-center gap-2">
          <span>✉️</span> Editorial and Support
        </h3>
        <p class="text-xs text-slate-600 mb-3 leading-relaxed">
          For editorial corrections, gift inquiries, or printable download feedback:
        </p>
        <a href="mailto:editorial@holidaygifthub.com" class="text-sm font-bold text-red-700 hover:underline">
          editorial@holidaygifthub.com
        </a>
      </div>

      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <h3 class="text-lg font-bold text-slate-900 mb-2 flex items-center gap-2">
          <span>🤝</span> Partnerships and Inquiries
        </h3>
        <p class="text-xs text-slate-600 mb-3 leading-relaxed">
          For brand placements, affiliate inquiries, or sponsorship opportunities:
        </p>
        <a href="mailto:partners@holidaygifthub.com" class="text-sm font-bold text-red-700 hover:underline">
          partners@holidaygifthub.com
        </a>
      </div>
    </div>

    <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 text-xs text-slate-500">
      <strong>Response Time:</strong> Our festive editorial team reviews incoming queries daily and responds within 24 to 48 hours.
    </div>
  </div>
</Layout>
