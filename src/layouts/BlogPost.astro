---
import Layout from './Layout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, author, category, isAffiliate, featuredImage } = post.data;
---

<Layout
  title={title}
  description={description}
  articleDate={pubDate}
  author={author}
  category={category}
  isAffiliate={isAffiliate}
  image={featuredImage}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-slate-500 mb-6 flex items-center gap-2">
      <a href="/" class="hover:text-red-700">Home</a>
      <span>/</span>
      <span class="text-slate-700 font-medium">{category}</span>
    </nav>

    <!-- Header info -->
    <div class="mb-8 border-b border-slate-200 pb-6">
      <span class="inline-block text-xs font-bold uppercase tracking-wider text-red-700 bg-red-50 border border-red-200 px-3 py-1 rounded-full mb-3">
        {category}
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight leading-tight mb-4">
        {title}
      </h1>
      <p class="text-lg text-slate-600 leading-relaxed mb-4">
        {description}
      </p>
      <div class="flex items-center gap-4 text-xs text-slate-500">
        <span>By <strong class="text-slate-800">{author}</strong></span>
        <span>•</span>
        <span>Updated for Q4 2026</span>
      </div>
    </div>

    <!-- Affiliate Notice Box -->
    {isAffiliate && (
      <div class="bg-amber-50/80 border border-amber-200 rounded-xl p-4 mb-8 text-xs text-amber-900 leading-relaxed">
        <strong class="font-bold">Affiliate Disclosure:</strong> HolidayGiftHub is reader-supported. When you purchase through links on our site, we may earn an affiliate commission from Amazon US or UK at no extra cost to you.
      </div>
    )}

    <!-- Content Slot -->
    <div class="prose prose-slate max-w-none prose-headings:font-bold prose-a:text-red-700 prose-img:rounded-xl">
      <slot />
    </div>
  </article>
</Layout>
